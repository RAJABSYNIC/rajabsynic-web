<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin - RAJABSYNIC</title>

    <link rel="icon" type="image/jpeg" href="/logo.jpeg">
    <!-- Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <!-- Icons -->
    <script type="module" src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.esm.js"></script>
    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.2/dist/chart.umd.min.js"></script>
    <!-- Styles -->
    <link rel="stylesheet" href="/styles/main.css">
    <style>
        :root {
            --sidebar-width: 280px;
            /* Slightly wider for subtitles */
            --sidebar-bg: #111217;
            --main-bg: #0b0c10;
            --accent-color: #00ff00;
            /* Neon Green */
            --active-bg: linear-gradient(90deg, rgba(0, 255, 0, 0.15) 0%, rgba(0, 255, 0, 0.05) 100%);
            /* Subtle Green Gradient */
            --text-muted: #9ca3af;
            --border-color: #1f2937;
        }

        body {
            display: flex;
            background: var(--main-bg);
            color: #fff;
            font-family: 'Inter', sans-serif;
            overflow: hidden;
            margin: 0;
        }

        /* Login Overlay */
        #login-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: #000;
            z-index: 1000;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        /* Sidebar */
        .sidebar {
            width: var(--sidebar-width);
            height: 100vh;
            background: var(--sidebar-bg);
            border-right: 1px solid var(--border-color);
            display: flex;
            flex-direction: column;
            padding: 20px 15px;
        }

        .sidebar-header {
            height: 60px;
            display: flex;
            align-items: center;
            padding: 0 15px;
            margin-bottom: 20px;
            font-size: 1.2rem;
            font-weight: 700;
            color: #fff;
        }

        .sidebar-menu {
            flex: 1;
            overflow-y: auto;
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .menu-item {
            display: flex;
            align-items: center;
            padding: 12px 15px;
            color: #d1d5db;
            cursor: pointer;
            transition: 0.2s;
            border-radius: 12px;
            /* Rounded Active State */
            gap: 15px;
        }

        .menu-item:hover {
            background: rgba(255, 255, 255, 0.03);
            color: #fff;
        }

        .menu-item.active {
            background: var(--active-bg);
            color: var(--accent-color);
            border-left: 3px solid var(--accent-color);
            border-radius: 0 12px 12px 0;
            /* Only round right side */
        }

        .menu-item.active .menu-desc {
            color: rgba(0, 255, 0, 0.7);
        }

        .menu-item ion-icon {
            font-size: 1.5rem;
            min-width: 24px;
        }

        .menu-text {
            display: flex;
            flex-direction: column;
        }

        .menu-title {
            font-weight: 600;
            font-size: 0.95rem;
        }

        .menu-desc {
            font-size: 0.75rem;
            color: #9ca3af;
            /* Muted text */
            margin-top: 2px;
        }

        .menu-item.active .menu-desc {
            color: rgba(255, 255, 255, 0.8);
        }

        /* Main Content */
        .main-content {
            flex: 1;
            height: 100vh;
            overflow-y: auto;
            padding: 30px;
        }

        /* View Sections */
        .view-section {
            display: none;
            animation: fadeIn 0.3s ease;
        }

        .view-section.active {
            display: block;
        }

        @keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(5px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        h2 {
            font-size: 1.5rem;
            margin-bottom: 25px;
            font-weight: 700;
        }

        /* Stats Cards */
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 25px;
            margin-bottom: 40px;
        }

        .stat-card {
            background: var(--sidebar-bg);
            padding: 25px;
            border-radius: 16px;
            border: 1px solid var(--border-color);
            position: relative;
        }

        .stat-card h3 {
            font-size: 0.85rem;
            color: var(--text-muted);
            margin-bottom: 10px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .stat-card .value {
            font-size: 2.5rem;
            font-weight: 700;
            color: #fff;
        }

        /* Named Links Styles */
        .link-row {
            display: flex;
            gap: 10px;
            margin-bottom: 10px;
            align-items: center;
            background: #1f2937;
            padding: 10px;
            border-radius: 8px;
        }

        .link-row input {
            flex: 1;
            padding: 8px;
            background: #111827;
            border: 1px solid #374151;
            color: white;
            border-radius: 4px;
            outline: none;
        }

        .btn-remove {
            background: #991b1b;
            color: #fff;
            width: 32px;
            height: 32px;
            border-radius: 6px;
            cursor: pointer;
            border: none;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: 0.2s;
        }

        .btn-remove:hover {
            background: #b91c1c;
        }

        .btn-add-link {
            background: #374151;
            color: #fff;
            padding: 8px 15px;
            border-radius: 6px;
            cursor: pointer;
            border: 1px solid #4b5563;
            font-size: 0.85rem;
            margin-top: 5px;
            display: inline-flex;
            align-items: center;
            gap: 5px;
        }

        /* Category Chips for Live TV */
        .category-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 10px;
            margin-top: 10px;
        }

        .cat-chip {
            background: #1f2937;
            border: 1px solid #374151;
            padding: 10px;
            border-radius: 8px;
            text-align: center;
            cursor: pointer;
            font-size: 0.85rem;
            transition: 0.2s;
            color: #9ca3af;
        }

        .cat-chip:hover {
            background: #374151;
        }

        .cat-chip.active {
            background: var(--accent-color);
            color: #000;
            border-color: var(--accent-color);
            font-weight: 600;
        }

        .stream-examples {
            font-size: 0.75rem;
            color: #9ca3af;
            margin-top: 8px;
            line-height: 1.4;
        }

        .stream-examples b {
            color: var(--accent-color);
        }

        .stat-card .icon {
            position: absolute;
            top: 25px;
            right: 25px;
            font-size: 2.5rem;
            color: #4b5563;
            opacity: 0.3;
        }

        /* Tables */
        .data-table-container {
            background: var(--sidebar-bg);
            border-radius: 16px;
            border: 1px solid var(--border-color);
            overflow: hidden;
        }

        .table-header {
            padding: 20px 25px;
            border-bottom: 1px solid var(--border-color);
            font-weight: 600;
            background: rgba(255, 255, 255, 0.02);
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        th,
        td {
            text-align: left;
            padding: 18px 25px;
            border-bottom: 1px solid var(--border-color);
            color: #e5e7eb;
            font-size: 0.95rem;
        }

        th {
            color: var(--text-muted);
            font-weight: 500;
            font-size: 0.8rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        tr:last-child td {
            border-bottom: none;
        }

        tr:hover td {
            background: rgba(255, 255, 255, 0.01);
        }

        .btn-sm {
            padding: 6px 12px;
            font-size: 0.8rem;
            border-radius: 6px;
            cursor: pointer;
            border: none;
            color: white;
            transition: 0.2s;
        }

        .btn-edit {
            background: #374151;
        }

        .btn-edit:hover {
            background: #4b5563;
        }

        .btn-del {
            background: #991b1b;
        }

        .btn-del {
            background: #7f1d1d;
        }

        .btn-del:hover {
            background: #991b1b;
        }

        .btn-primary {
            background: #008000;
            color: white;
            padding: 10px 20px;
            border-radius: 8px;
            border: none;
            cursor: pointer;
            font-weight: 600;
        }

        .btn-primary:hover {
            background: #00a000;
        }

        /* Modal */
        .modal {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.8);
            z-index: 500;
            display: none;
            align-items: center;
            justify-content: center;
            backdrop-filter: blur(5px);
        }

        .modal-content {
            background: #1f2937;
            padding: 30px;
            border-radius: 16px;
            width: 500px;
            max-width: 95%;
            max-height: 90vh;
            overflow-y: auto;
            border: 1px solid #374151;
            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
        }

        .modal.show {
            display: flex;
        }

        .input-group {
            margin-bottom: 20px;
        }

        .input-group label {
            display: block;
            margin-bottom: 8px;
            color: #9ca3af;
            font-size: 0.9rem;
        }

        .input-group input,
        .input-group select {
            width: 100%;
            padding: 12px;
            background: #111827;
            border: 1px solid #374151;
            color: white;
            border-radius: 8px;
            outline: none;
        }

        .input-group input:focus {
            border-color: #6366f1;
        }

        /* ============================================================
           PROFESSIONAL THEME POLISH
           ============================================================ */
        :root {
            --accent: #22c55e;
            --accent-color: #22c55e;
            --accent-strong: #16a34a;
            --accent-soft: rgba(34, 197, 94, 0.12);
            --active-bg: linear-gradient(90deg, rgba(34, 197, 94, 0.16) 0%, rgba(34, 197, 94, 0.02) 100%);
            --surface: #12141c;
            --surface-2: #161922;
            --surface-3: #1b1f2b;
            --border: #242a38;
            --border-color: #242a38;
            --text: #e6e9ef;
            --text-muted: #93a0b4;
            --radius: 14px;
            --radius-sm: 10px;
            --shadow: 0 6px 24px rgba(0, 0, 0, 0.28);
            --shadow-lg: 0 16px 48px rgba(0, 0, 0, 0.45);
        }

        * { box-sizing: border-box; }

        body {
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
            color: var(--text);
            letter-spacing: 0.1px;
            background:
                radial-gradient(1200px 600px at 100% -10%, rgba(34, 197, 94, 0.05), transparent 60%),
                var(--main-bg);
        }

        /* Slim custom scrollbars */
        ::-webkit-scrollbar { width: 10px; height: 10px; }
        ::-webkit-scrollbar-track { background: transparent; }
        ::-webkit-scrollbar-thumb { background: #2a3040; border-radius: 8px; border: 2px solid transparent; background-clip: padding-box; }
        ::-webkit-scrollbar-thumb:hover { background: #3a4256; background-clip: padding-box; }

        /* Sidebar */
        .sidebar {
            background: linear-gradient(180deg, #0f1118 0%, #0c0e14 100%);
            border-right: 1px solid var(--border);
            padding: 18px 14px;
        }
        .sidebar-header {
            height: auto;
            font-size: 1.25rem;
            letter-spacing: 0.5px;
            border-bottom: 1px solid var(--border);
            margin-bottom: 16px;
            padding: 4px 15px 14px;
        }
        .sidebar-menu { gap: 4px; }
        .menu-item {
            padding: 11px 14px;
            border-radius: var(--radius-sm);
            border-left: 3px solid transparent;
            transition: background .18s ease, color .18s ease, border-color .18s ease;
        }
        .menu-item:hover { background: rgba(255, 255, 255, 0.04); }
        .menu-item.active {
            background: var(--accent-soft);
            color: var(--accent);
            border-left: 3px solid var(--accent);
            border-radius: var(--radius-sm);
        }
        .menu-item.active ion-icon { color: var(--accent); }
        .menu-item.active .menu-desc { color: rgba(34, 197, 94, 0.75); }
        .menu-title { font-weight: 600; font-size: 0.92rem; }
        .menu-desc { font-size: 0.72rem; }

        /* Main content + headings */
        .main-content { padding: 32px 34px; }
        h2 { font-weight: 700; letter-spacing: -0.2px; }
        h3 { letter-spacing: 0.2px; }

        /* Stat cards */
        .stats-grid { gap: 20px; }
        .stat-card {
            background: linear-gradient(180deg, var(--surface-2), var(--surface));
            border: 1px solid var(--border);
            border-radius: var(--radius);
            box-shadow: var(--shadow);
            transition: transform .18s ease, border-color .18s ease, box-shadow .18s ease;
        }
        .stat-card:hover { transform: translateY(-3px); border-color: #303748; box-shadow: var(--shadow-lg); }
        .stat-card h3 { letter-spacing: 0.6px; }
        .stat-card .value { font-variant-numeric: tabular-nums; letter-spacing: -0.5px; }

        /* Tables */
        .data-table-container {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            box-shadow: var(--shadow);
        }
        .table-header { background: var(--surface-2); border-bottom: 1px solid var(--border); font-weight: 700; letter-spacing: 0.2px; }
        table th { background: var(--surface-2); color: var(--text-muted); letter-spacing: 0.6px; border-bottom: 1px solid var(--border); }
        table td { border-bottom: 1px solid rgba(255, 255, 255, 0.04); }
        tbody tr { transition: background .12s ease; }
        tbody tr:hover td { background: rgba(255, 255, 255, 0.025); }

        /* Buttons */
        .btn-primary {
            background: linear-gradient(135deg, var(--accent), var(--accent-strong));
            border: none; color: #05130a; font-weight: 700;
            border-radius: var(--radius-sm); padding: 10px 18px; cursor: pointer;
            transition: transform .15s ease, box-shadow .15s ease, filter .15s ease;
            box-shadow: 0 4px 16px rgba(34, 197, 94, 0.25);
        }
        .btn-primary:hover { filter: brightness(1.06); transform: translateY(-1px); box-shadow: 0 8px 24px rgba(34, 197, 94, 0.32); }
        .btn-sm { border-radius: 8px; transition: filter .15s ease, transform .15s ease; }
        .btn-sm:hover { filter: brightness(1.12); }
        .btn-sm:disabled { opacity: .4; cursor: not-allowed; filter: none; }
        .btn-edit { background: var(--surface-3); border: 1px solid var(--border); color: #cbd5e1; }
        .btn-del { background: #7f1d1d; }
        .btn-del:hover { background: #991b1b; }

        /* Inputs */
        .input-group label { color: var(--text-muted); font-size: 0.82rem; font-weight: 600; letter-spacing: 0.2px; }
        .input-group input, .input-group select, .input-group textarea {
            background: #0e1017;
            border: 1px solid var(--border);
            border-radius: var(--radius-sm);
            color: var(--text);
            transition: border-color .15s ease, box-shadow .15s ease;
        }
        .input-group input:focus, .input-group select:focus, .input-group textarea:focus {
            border-color: var(--accent);
            box-shadow: 0 0 0 3px var(--accent-soft);
            outline: none;
        }

        /* Modal */
        .modal { backdrop-filter: blur(6px); background: rgba(3, 5, 10, 0.72); }
        .modal-content {
            background: linear-gradient(180deg, var(--surface-2), var(--surface));
            border: 1px solid var(--border);
            border-radius: 18px;
            box-shadow: var(--shadow-lg);
        }

        /* Mobile Responsiveness */
        .mobile-header {
            display: none;
            background: var(--sidebar-bg);
            padding: 15px 20px;
            align-items: center;
            justify-content: space-between;
            border-bottom: 1px solid var(--border-color);
        }
        .mobile-menu-btn {
            background: none;
            border: none;
            color: #fff;
            font-size: 1.8rem;
            cursor: pointer;
        }

        @media (max-width: 768px) {
            body {
                flex-direction: column;
            }
            .mobile-header {
                display: flex;
            }
            .sidebar {
                position: fixed;
                left: -100%;
                top: 0;
                z-index: 999;
                transition: left 0.3s ease;
                box-shadow: 5px 0 15px rgba(0,0,0,0.5);
            }
            .sidebar.show {
                left: 0;
            }
            .sidebar-overlay {
                position: fixed;
                top: 0; left: 0; width: 100%; height: 100%;
                background: rgba(0,0,0,0.5);
                z-index: 998;
                display: none;
            }
            .sidebar-overlay.show {
                display: block;
            }
            .main-content {
                padding: 15px;
                height: calc(100vh - 60px);
            }
            .stats-grid {
                grid-template-columns: 1fr;
            }
            div[style*="grid-template-columns: 1fr 1fr;"] {
                grid-template-columns: 1fr !important;
            }
            .modal-content {
                width: 95%;
                padding: 20px;
            }
            table {
                display: block;
                overflow-x: auto;
                white-space: nowrap;
            }
            /* Fix login overlay width */
            #login-overlay > div {
                width: 90% !important;
                padding: 25px !important;
            }
        }
    </style>
</head>

<body>

    <!-- Sidebar Overlay -->
    <div id="sidebar-overlay" class="sidebar-overlay" onclick="toggleMobileMenu()"></div>

    <!-- Mobile Header -->
    <div class="mobile-header">
        <div style="font-size: 1.2rem; font-weight: 700; color: #fff;">
            RAJAB<span style="color: #22c55e; margin-left: 2px;">SYNIC</span>
        </div>
        <button class="mobile-menu-btn" onclick="toggleMobileMenu()">
            <ion-icon name="menu-outline"></ion-icon>
        </button>
    </div>
    
    <script>
        function toggleMobileMenu() {
            document.querySelector('.sidebar').classList.toggle('show');
            document.getElementById('sidebar-overlay').classList.toggle('show');
        }
        
        document.addEventListener('DOMContentLoaded', () => {
            const menuItems = document.querySelectorAll('.menu-item');
            menuItems.forEach(item => {
                item.addEventListener('click', () => {
                    if (window.innerWidth <= 768) {
                        document.querySelector('.sidebar').classList.remove('show');
                        document.getElementById('sidebar-overlay').classList.remove('show');
                    }
                });
            });
        });
    </script>

    <!-- Login Overlay -->
    <div id="login-overlay" style="background:radial-gradient(ellipse at center,#0d1a0f 0%,#060810 100%);">
        <div style="width:360px;padding:44px 40px;background:rgba(17,18,23,0.97);border-radius:20px;border:1px solid rgba(0,255,128,0.2);box-shadow:0 0 60px rgba(0,255,128,0.06),0 20px 60px rgba(0,0,0,0.7);backdrop-filter:blur(16px);">
            <div style="text-align:center;margin-bottom:32px;">
                <div style="font-size:1.6rem;font-weight:900;letter-spacing:2px;color:#fff;margin-bottom:6px;">RAJAB<span style="color:#00ff80;">SYNIC</span></div>
                <div style="font-size:0.72rem;color:#6b7280;font-weight:700;letter-spacing:4px;text-transform:uppercase;">Admin Panel</div>
                <div style="width:48px;height:2px;background:linear-gradient(90deg,transparent,#00ff80,transparent);margin:14px auto 0;"></div>
            </div>
            <input type="email" id="admin-user" placeholder="Email" autocomplete="username"
                onkeydown="if(event.key===&apos;Enter&apos;)adminApp.login()"
                onfocus="this.style.borderColor=&apos;rgba(0,255,128,0.5)&apos;" onblur="this.style.borderColor=&apos;#1f2937&apos;"
                style="width:100%;margin-bottom:14px;padding:14px 16px;border-radius:10px;background:#0b0c10;border:1px solid #1f2937;color:#fff;font-size:0.95rem;outline:none;box-sizing:border-box;transition:border-color 0.2s;">
            <input type="password" id="admin-pass" placeholder="Password"
                onkeydown="if(event.key===&apos;Enter&apos;)adminApp.login()"
                onfocus="this.style.borderColor=&apos;rgba(0,255,128,0.5)&apos;" onblur="this.style.borderColor=&apos;#1f2937&apos;"
                style="width:100%;margin-bottom:24px;padding:14px 16px;border-radius:10px;background:#0b0c10;border:1px solid #1f2937;color:#fff;font-size:0.95rem;outline:none;box-sizing:border-box;transition:border-color 0.2s;">
            <button id="login-btn" onclick="if(window.adminApp) { window.adminApp.login(); } else { alert('App is still loading, please wait...'); console.error('adminApp is not defined'); }"
                onmouseover="this.style.boxShadow='0 8px 30px rgba(0,255,128,0.45)';this.style.transform='translateY(-1px)'"
                onmouseout="this.style.boxShadow='0 4px 20px rgba(0,255,128,0.25)';this.style.transform='translateY(0)'"
                style="width:100%;padding:14px;border-radius:10px;background:linear-gradient(135deg,#00ff80,#00cc66);border:none;color:#000;font-size:0.95rem;font-weight:800;cursor:pointer;letter-spacing:0.5px;transition:all 0.2s;box-shadow:0 4px 20px rgba(0,255,128,0.25);">
                Ingia Dashboard
            </button>
            <p id="login-error" style="color:#ef4444;margin-top:16px;text-align:center;font-size:0.85rem;min-height:20px;"></p>
        </div>
    </div>

    <!-- Sidebar -->
    <div class="sidebar">
        <div class="sidebar-header">
            RAJAB<span style="color: #22c55e; margin-left: 2px;">SYNIC</span>
        </div>
        <div class="sidebar-menu">
            <div class="menu-item active" onclick="adminApp.navigate('dashboard')">
                <ion-icon name="home-outline"></ion-icon>
                <div class="menu-text">
                    <span class="menu-title">Dashboard</span>
                    <span class="menu-desc">Overview and analytics</span>
                </div>
            </div>
            <div class="menu-item" onclick="adminApp.navigate('users')">
                <ion-icon name="people-outline"></ion-icon>
                <div class="menu-text">
                    <span class="menu-title">Manage Users</span>
                    <span class="menu-desc">User management and permissions</span>
                </div>
            </div>
            <div class="menu-item" onclick="adminApp.navigate('games')">
                <ion-icon name="game-controller-outline"></ion-icon>
                <div class="menu-text">
                    <span class="menu-title">Game Management</span>
                    <span class="menu-desc">Manage games and downloads</span>
                </div>
            </div>
            <div class="menu-item" onclick="adminApp.navigate('livetv')">
                <ion-icon name="radio-outline"></ion-icon>
                <div class="menu-text">
                    <span class="menu-title">Live TV Channels</span>
                    <span class="menu-desc">Manage live streaming channels</span>
                </div>
            </div>
            <div class="menu-item" onclick="adminApp.navigate('adult')">
                <ion-icon name="videocam-outline"></ion-icon>
                <div class="menu-text">
                    <span class="menu-title">Adult Content</span>
                    <span class="menu-desc">18+ Videos</span>
                </div>
            </div>
            <div class="menu-item" onclick="adminApp.navigate('payments')">
                <ion-icon name="card-outline"></ion-icon>
                <div class="menu-text">
                    <span class="menu-title">Payment Management</span>
                    <span class="menu-desc">Subscriptions and payments</span>
                </div>
            </div>

            <div class="menu-item" onclick="adminApp.navigate('settings')">
                <ion-icon name="settings-outline"></ion-icon>
                <div class="menu-text">
                    <span class="menu-title">System Settings</span>
                    <span class="menu-desc">App configuration</span>
                </div>
            </div>

            <div class="menu-item" onclick="adminApp.navigate('withdrawals')" id="menu-withdrawals">
                <ion-icon name="cash-outline" style="color:#4ade80;"></ion-icon>
                <div class="menu-text" style="flex:1;">
                    <span class="menu-title" style="display:flex;align-items:center;gap:8px;">
                        Toa Pesa
                        <span id="withdrawal-badge" style="display:none;background:#ef4444;color:#fff;border-radius:20px;padding:1px 7px;font-size:0.7rem;font-weight:800;min-width:18px;text-align:center;"></span>
                    </span>
                    <span class="menu-desc">Maombi ya kutoa pesa</span>
                </div>
            </div>

            <div class="menu-item" onclick="location.reload()" style="margin-top: auto;">
                <ion-icon name="log-out-outline" style="color: crimson;"></ion-icon>
                <div class="menu-text">
                    <span class="menu-title" style="color: crimson;">Logout</span>
                    <span class="menu-desc">End session</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Content -->
    <div class="main-content">

        <!-- WITHDRAWALS VIEW — Toa Pesa -->
        <div id="view-withdrawals" class="view-section">
            <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px;margin-bottom:6px;">
                <div>
                    <h2 style="margin:0 0 4px;">💸 Maombi ya Toa Pesa</h2>
                    <p style="color:#9ca3af;font-size:0.9rem;margin:0;">Angalia na kushughulikia maombi ya kutoa pesa za referral.</p>
                </div>
                <div style="display:flex;align-items:center;gap:8px;background:rgba(74,222,128,0.05);border:1px solid rgba(74,222,128,0.2);color:#4ade80;border-radius:12px;padding:8px 16px;font-size:0.82rem;font-weight:700;">
                    <ion-icon name="sync" id="wd-auto-icon" style="font-size:1rem;"></ion-icon>
                    <span id="wd-auto-label">Auto-refresh: 10s</span>
                </div>
            </div>

            <!-- Stats row -->
            <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:16px;margin:20px 0;">
                <div style="background:#111217;border:1px solid #1f2937;border-radius:14px;padding:18px;text-align:center;">
                    <div id="wd-stat-pending" style="font-size:2rem;font-weight:900;color:#f59e0b;">0</div>
                    <div style="color:#9ca3af;font-size:0.78rem;font-weight:700;text-transform:uppercase;margin-top:4px;">Zinazosubiri</div>
                </div>
                <div style="background:#111217;border:1px solid #1f2937;border-radius:14px;padding:18px;text-align:center;">
                    <div id="wd-stat-approved" style="font-size:2rem;font-weight:900;color:#4ade80;">0</div>
                    <div style="color:#9ca3af;font-size:0.78rem;font-weight:700;text-transform:uppercase;margin-top:4px;">Zilizokubaliwa</div>
                </div>
                <div style="background:#111217;border:1px solid #1f2937;border-radius:14px;padding:18px;text-align:center;">
                    <div id="wd-stat-total" style="font-size:2rem;font-weight:900;color:#60a5fa;">Tsh 0</div>
                    <div style="color:#9ca3af;font-size:0.78rem;font-weight:700;text-transform:uppercase;margin-top:4px;">Jumla Iliyolipwa</div>
                </div>
            </div>

            <!-- Table -->
            <div class="data-table-container">
                <div class="table-header" style="display:flex;align-items:center;gap:10px;">
                    <ion-icon name="list-outline" style="color:#4ade80;font-size:1.2rem;"></ion-icon>
                    Orodha ya Maombi
                </div>
                <div id="withdrawals-list" style="padding:20px;color:#9ca3af;text-align:center;"></div>
            </div>
        </div>

        <!-- PUSH NOTIFICATIONS VIEW -->
        <div id="view-notifications" class="view-section">
            <h2 style="margin-bottom:8px;">Push Notifications</h2>
            <p style="color:#9ca3af; margin-bottom:25px; font-size:0.9rem;">Tuma notification kwa watumiaji wote au mtu maalum.</p>

            <div style="display:grid; grid-template-columns: 1fr 1fr; gap:25px; align-items:start;">

                <!-- Send Form -->
                <div style="background:#1a1a2e; border:1px solid #2d2d4e; border-radius:16px; padding:25px;">
                    <h3 style="color:#22c55e; margin-bottom:20px; display:flex; align-items:center; gap:8px;">
                        <ion-icon name="send-outline"></ion-icon> Tunga Notification
                    </h3>

                    <div style="margin-bottom:16px;">
                        <label style="color:#9ca3af; font-size:0.8rem; font-weight:700; text-transform:uppercase; display:block; margin-bottom:6px;">Kichwa (Title)</label>
                        <input id="notif-title" type="text" placeholder="Mfano: Mchezo Mpya Umewasili!" 
                               style="width:100%; background:#111; border:1px solid #333; border-radius:10px; padding:12px 14px; color:#fff; font-size:0.95rem; box-sizing:border-box;">
                    </div>

                    <div style="margin-bottom:16px;">
                        <label style="color:#9ca3af; font-size:0.8rem; font-weight:700; text-transform:uppercase; display:block; margin-bottom:6px;">Ujumbe (Body)</label>
                        <textarea id="notif-body" rows="4" placeholder="Andika ujumbe wako hapa..."
                                  style="width:100%; background:#111; border:1px solid #333; border-radius:10px; padding:12px 14px; color:#fff; font-size:0.95rem; resize:vertical; box-sizing:border-box;"></textarea>
                    </div>

                    <!-- Image: Tabs for Link or Upload -->
                    <div style="margin-bottom:16px;">
                        <label style="color:#9ca3af; font-size:0.8rem; font-weight:700; text-transform:uppercase; display:block; margin-bottom:10px;">Picha (Optional)</label>
                        
                        <!-- Tab Switcher -->
                        <div style="display:flex; background:#0a0a0a; border:1px solid #333; border-radius:10px; padding:4px; margin-bottom:12px; gap:4px;">
                            <button id="img-tab-link" onclick="adminApp.switchImageTab('link')"
                                    style="flex:1; background:#22c55e; color:#000; border:none; border-radius:7px; padding:8px; font-weight:700; font-size:0.85rem; cursor:pointer; display:flex; align-items:center; justify-content:center; gap:6px; transition:all 0.2s;">
                                <ion-icon name="link-outline"></ion-icon> Link URL
                            </button>
                            <button id="img-tab-upload" onclick="adminApp.switchImageTab('upload')"
                                    style="flex:1; background:transparent; color:#9ca3af; border:none; border-radius:7px; padding:8px; font-weight:700; font-size:0.85rem; cursor:pointer; display:flex; align-items:center; justify-content:center; gap:6px; transition:all 0.2s;">
                                <ion-icon name="cloud-upload-outline"></ion-icon> Upload
                            </button>
                        </div>

                        <!-- Link Input Panel -->
                        <div id="img-panel-link">
                            <input id="notif-image" type="text" placeholder="https://example.com/image.jpg" 
                                   oninput="adminApp.previewNotifImage(this.value)"
                                   style="width:100%; background:#111; border:1px solid #333; border-radius:10px; padding:12px 14px; color:#fff; font-size:0.95rem; box-sizing:border-box;">
                        </div>

                        <!-- Upload Panel -->
                        <div id="img-panel-upload" style="display:none;">
                            <label for="notif-img-file" 
                                   style="display:flex; flex-direction:column; align-items:center; justify-content:center; background:#111; border:2px dashed #333; border-radius:10px; padding:20px; cursor:pointer; transition:border-color 0.2s;"
                                   onmouseover="this.style.borderColor='#22c55e'" onmouseout="this.style.borderColor='#333'">
                                <ion-icon name="image-outline" style="font-size:2rem; color:#9ca3af; margin-bottom:8px;"></ion-icon>
                                <span style="color:#9ca3af; font-size:0.85rem; font-weight:600;">Bonyeza kuchagua picha</span>
                                <span style="color:#6b7280; font-size:0.75rem; margin-top:4px;">PNG, JPG, GIF (max 10MB)</span>
                            </label>
                            <input id="notif-img-file" type="file" accept="image/*" style="display:none;" onchange="adminApp.handleNotifImageUpload(this)">
                            
                            <!-- Upload Progress -->
                            <div id="notif-upload-status" style="display:none; margin-top:10px; text-align:center; color:#9ca3af; font-size:0.85rem;"></div>
                        </div>

                        <!-- Image Preview -->
                        <div id="notif-img-preview" style="display:none; margin-top:10px; position:relative;">
                            <img id="notif-img-preview-img" src="" style="width:100%; max-height:120px; object-fit:cover; border-radius:8px; border:1px solid #333;">
                            <button onclick="adminApp.clearNotifImage()" 
                                    style="position:absolute; top:6px; right:6px; background:rgba(0,0,0,0.7); border:none; border-radius:50%; width:26px; height:26px; color:#fff; cursor:pointer; display:flex; align-items:center; justify-content:center; font-size:1rem;">✕</button>
                        </div>
                    </div>

                    <div style="margin-bottom:20px;">
                        <label style="color:#9ca3af; font-size:0.8rem; font-weight:700; text-transform:uppercase; display:block; margin-bottom:6px;">Tuma Kwa</label>
                        <select id="notif-target"
                                style="width:100%; background:#111; border:1px solid #333; border-radius:10px; padding:12px 14px; color:#fff; font-size:0.95rem; box-sizing:border-box;">
                            <option value="all"><ion-icon name="people-outline"></ion-icon> Watumiaji Wote</option>
                            <option value="topic-games"><ion-icon name="game-controller-outline"></ion-icon> Wapenzi wa Games</option>
                            <option value="topic-movies"><ion-icon name="film-outline"></ion-icon> Wapenzi wa Movies</option>
                            <option value="topic-live"><ion-icon name="radio-outline"></ion-icon> Wapenzi wa Live TV</option>
                        </select>
                    </div>

                    <button onclick="adminApp.sendPushNotification()" 
                            style="width:100%; background:linear-gradient(135deg, #22c55e, #16a34a); border:none; border-radius:12px; padding:14px; color:#fff; font-weight:800; font-size:1rem; cursor:pointer; display:flex; align-items:center; justify-content:center; gap:10px;">
                        <ion-icon name="send" style="font-size:1.2rem;"></ion-icon>
                        TUMA NOTIFICATION
                    </button>

                    <div id="notif-status" style="margin-top:15px; display:none;"></div>
                </div>

                <!-- Preview + History -->
                <div style="display:flex; flex-direction:column; gap:20px;">
                    <!-- Preview -->
                    <div style="background:#1a1a2e; border:1px solid #2d2d4e; border-radius:16px; padding:25px;">
                        <h3 style="color:#9ca3af; font-size:0.85rem; font-weight:700; text-transform:uppercase; margin-bottom:15px;"><ion-icon name="phone-portrait-outline" style="vertical-align: text-bottom; font-size: 1.1rem;"></ion-icon> Preview</h3>
                        <div style="background:#000; border-radius:12px; padding:14px; display:flex; gap:12px; align-items:flex-start;">
                            <div style="width:40px; height:40px; background:#22c55e; border-radius:10px; display:flex; align-items:center; justify-content:center; flex-shrink:0;">
                                <ion-icon name="notifications" style="color:#fff; font-size:1.3rem;"></ion-icon>
                            </div>
                            <div style="flex:1;">
                                <div id="preview-title" style="color:#fff; font-weight:700; font-size:0.9rem; margin-bottom:4px;">Kichwa kitaonekana hapa</div>
                                <div id="preview-body" style="color:#9ca3af; font-size:0.8rem; line-height:1.4;">Ujumbe wako utaonekana hapa...</div>
                                <div style="color:#6b7280; font-size:0.7rem; margin-top:6px;">RAJABSYNIC • Sasa hivi</div>
                            </div>
                        </div>
                    </div>

                    <!-- History -->
                    <div style="background:#1a1a2e; border:1px solid #2d2d4e; border-radius:16px; padding:25px;">
                        <h3 style="color:#9ca3af; font-size:0.85rem; font-weight:700; text-transform:uppercase; margin-bottom:15px;"><ion-icon name="list-outline" style="vertical-align: text-bottom; font-size: 1.1rem;"></ion-icon> Historia ya Notifications</h3>
                        <div id="notif-history" style="display:flex; flex-direction:column; gap:10px; max-height:300px; overflow-y:auto;">
                            <p style="color:#6b7280; font-size:0.85rem; text-align:center; padding:20px;">Bado hakuna notification zilizotumwa.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- DASHBOARD VIEW -->
        <div id="view-dashboard" class="view-section active">
            <div style="display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:12px; margin-bottom:6px;">
                <h2 style="margin:0;">Dashboard Overview</h2>
                <div style="display:flex;align-items:center;gap:8px;background:rgba(0,255,128,0.05);border:1px solid rgba(0,255,128,0.2);color:#00ff80;border-radius:12px;padding:8px 16px;font-size:0.82rem;font-weight:700;">
                    <ion-icon name="sync" id="dash-auto-icon" style="font-size:1rem;"></ion-icon>
                    <span id="dash-auto-label">Auto-refresh: 30s</span>
                </div>
            </div>

            <div class="stats-grid">
                <div class="stat-card">
                    <h3>Total Games</h3>
                    <div class="value" id="stat-games">0</div>
                    <div class="icon"><ion-icon name="game-controller"></ion-icon></div>
                </div>
                <div class="stat-card">
                    <h3>Total Users</h3>
                    <div class="value" id="stat-users">0</div>
                    <div class="icon"><ion-icon name="people"></ion-icon></div>
                </div>
                <!-- ACTIVE USERS CARD -->
                <div class="stat-card" style="border:1px solid rgba(74,222,128,0.3);background:linear-gradient(135deg,#0a1f0a,#111217);">
                    <h3 style="color:#4ade80;">🟢 Active Sasa Hivi</h3>
                    <div class="value" id="stat-active-users" style="color:#4ade80;font-size:2.2rem;">0</div>
                    <div style="color:#6b7280;font-size:0.78rem;margin-top:4px;" id="stat-active-sub">Wanaotembelea sasa hivi</div>
                    <div class="icon"><ion-icon name="wifi" style="color:#4ade80;"></ion-icon></div>
                </div>
                <!-- DEAD USERS CARD -->
                <div class="stat-card" style="border:1px solid rgba(239,68,68,0.25);background:linear-gradient(135deg,#1a0a0a,#111217);">
                    <h3 style="color:#f87171;">💀 Dead Users</h3>
                    <div class="value" id="stat-dead-users" style="color:#f87171;font-size:2.2rem;">0</div>
                    <div style="color:#6b7280;font-size:0.78rem;margin-top:4px;">Hawaji tena / sana chache</div>
                    <div class="icon"><ion-icon name="moon" style="color:#f87171;"></ion-icon></div>
                </div>
                <div class="stat-card">
                    <h3>Admins</h3>
                    <div class="value" id="stat-admins">0</div>
                    <div class="icon"><ion-icon name="shield"></ion-icon></div>
                    <div style="margin-top: 15px;">
                        <button class="btn-sm" onclick="adminApp.debugConnection()"
                            style="background: #374151; color: white; border: 1px solid #4b5563; width: 100%; cursor: pointer;">Test
                            Backend</button>
                    </div>
                </div>
                <!-- TOTAL REVENUE CARD -->
                <div class="stat-card" style="border: 1px solid rgba(0,255,128,0.25); background: linear-gradient(135deg, #0d1f12 0%, #111217 100%);">
                    <h3 style="color: #00ff80;">Total Revenue (Lifetime)</h3>
                    <div class="value" id="stat-total-revenue" style="color: #00ff80; font-size: 2rem;">Tsh 0</div>
                    <div style="margin-top: 8px; font-size: 0.82rem; color: #6b7280;" id="stat-total-txns">0 malipo</div>
                    <div class="icon"><ion-icon name="cash" style="color: #00ff80;"></ion-icon></div>
                </div>
            </div>

            <!-- REVENUE CHART SECTION -->
            <div style="background: #111217; border: 1px solid #1f2937; border-radius: 20px; padding: 28px; margin-bottom: 35px;">
                <!-- Header row -->
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px; flex-wrap: wrap; gap: 14px;">
                    <div>
                        <h3 style="font-size: 1.1rem; font-weight: 700; color: #fff; margin: 0;">📈 Revenue Overview</h3>
                        <p style="color: #6b7280; font-size: 0.82rem; margin: 4px 0 0;">Kilichopatikana kwa kipindi kilichochaguliwa</p>
                    </div>
                    <!-- Period filter tabs -->
                    <div style="display: flex; background: #0b0c10; border: 1px solid #1f2937; border-radius: 12px; padding: 4px; gap: 4px;">
                        <button id="rev-tab-7days" onclick="adminApp.loadRevenueChart('7days')" class="rev-tab active"
                            style="padding: 7px 16px; border-radius: 8px; border: none; font-size: 0.82rem; font-weight: 700; cursor: pointer; background: #00ff80; color: #000; transition: all 0.2s;">7 Siku</button>
                        <button id="rev-tab-month" onclick="adminApp.loadRevenueChart('month')" class="rev-tab"
                            style="padding: 7px 16px; border-radius: 8px; border: none; font-size: 0.82rem; font-weight: 700; cursor: pointer; background: transparent; color: #9ca3af; transition: all 0.2s;">Mwezi</button>
                        <button id="rev-tab-year" onclick="adminApp.loadRevenueChart('year')" class="rev-tab"
                            style="padding: 7px 16px; border-radius: 8px; border: none; font-size: 0.82rem; font-weight: 700; cursor: pointer; background: transparent; color: #9ca3af; transition: all 0.2s;">Mwaka</button>
                        <button id="rev-tab-lifetime" onclick="adminApp.loadRevenueChart('lifetime')" class="rev-tab"
                            style="padding: 7px 16px; border-radius: 8px; border: none; font-size: 0.82rem; font-weight: 700; cursor: pointer; background: transparent; color: #9ca3af; transition: all 0.2s;">Lifetime</button>
                    </div>
                </div>
                <!-- Period revenue summary -->
                <div style="display: flex; gap: 24px; margin-bottom: 20px; flex-wrap: wrap;">
                    <div style="background: #0b0c10; border: 1px solid #1f2937; border-radius: 12px; padding: 14px 22px;">
                        <div style="color: #6b7280; font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px;">Kipato cha Kipindi</div>
                        <div id="rev-period-amount" style="color: #00ff80; font-size: 1.5rem; font-weight: 800; margin-top: 4px;">Tsh 0</div>
                    </div>
                    <div style="background: #0b0c10; border: 1px solid #1f2937; border-radius: 12px; padding: 14px 22px;">
                        <div style="color: #6b7280; font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px;">Jumla Yote</div>
                        <div id="rev-total-amount" style="color: #fff; font-size: 1.5rem; font-weight: 800; margin-top: 4px;">Tsh 0</div>
                    </div>
                </div>
                <!-- Chart canvas -->
                <div style="position: relative; height: 280px;">
                    <canvas id="revenueChart"></canvas>
                </div>
            </div>

            
            <!-- GATEWAY BREAKDOWN -->
            <div style="margin-bottom:35px;">
                <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:18px; flex-wrap:wrap; gap:10px;">
                    <div>
                        <h3 style="margin:0; font-size:1.05rem; font-weight:700; color:#fff;">?? Mapato kwa Gateway</h3>
                        <p style="margin:4px 0 0; font-size:0.8rem; color:#6b7280;">Kila gateway inaonyesha jumla yake � inasasishwa kiotomatiki</p>
                    </div>
                </div>
                <div id="gateway-breakdown-grid" style="display:grid; grid-template-columns:repeat(auto-fill,minmax(230px,1fr)); gap:16px;">
                    <div style="color:#6b7280; font-size:0.85rem; padding:20px; text-align:center;">Inapakia...</div>
                </div>
            </div>

            <!-- USER ACTIVITY SECTION -->
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-bottom:35px;" id="activity-panels">

                <!-- Active Users Panel -->
                <div style="background:#111217;border:1px solid rgba(74,222,128,0.25);border-radius:20px;padding:22px;">
                    <div style="display:flex;align-items:center;gap:10px;margin-bottom:16px;">
                        <div style="width:10px;height:10px;background:#4ade80;border-radius:50%;box-shadow:0 0 8px #4ade80;animation:pulse 1.5s ease-in-out infinite;"></div>
                        <h3 style="margin:0;color:#4ade80;font-size:1rem;">Waliopo Online Sasa</h3>
                    </div>
                    <div id="active-users-list" style="max-height:280px;overflow-y:auto;">
                        <div style="color:#6b7280;text-align:center;padding:30px;font-size:0.85rem;">Inapakia...</div>
                    </div>
                </div>

                <!-- Dead Users Panel -->
                <div style="background:#111217;border:1px solid rgba(239,68,68,0.2);border-radius:20px;padding:22px;">
                    <div style="display:flex;align-items:center;gap:10px;margin-bottom:16px;">
                        <ion-icon name="moon" style="color:#f87171;font-size:1.1rem;"></ion-icon>
                        <h3 style="margin:0;color:#f87171;font-size:1rem;">Dead Users (Hawaji Tena)</h3>
                    </div>
                    <div id="dead-users-list" style="max-height:280px;overflow-y:auto;">
                        <div style="color:#6b7280;text-align:center;padding:30px;font-size:0.85rem;">Inapakia...</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- USERS VIEW -->
        <div id="view-users" class="view-section">
            <div style="display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:10px; margin-bottom: 20px;">
                <h2 style="margin:0; font-size: 1.5rem;">Manage Users <span id="users-count" style="color:#4ade80; font-size:1rem; font-weight:600;"></span></h2>
            </div>

            <div style="background: #1f2937; border: 1px solid #374151; border-radius: 12px; margin-bottom: 20px;">
                <input type="text" id="users-search" oninput="adminApp.searchUsers(this.value)" placeholder="Search by name, phone or email..." style="width: 100%; border: none; background: transparent; padding: 18px 20px; color: #fff; outline: none; font-size: 0.95rem;">
            </div>

            <div class="data-table-container" style="border-radius: 12px; overflow: hidden; border: 1px solid #374151;">
                <table style="width: 100%; border-collapse: collapse;">
                    <thead>
                        <tr style="border-bottom: 1px solid #374151;">
                            <th style="color: #9ca3af; text-transform: uppercase; font-size: 0.8rem; padding: 16px; text-align: left; font-weight: 600;">USERNAME</th>
                            <th style="color: #9ca3af; text-transform: uppercase; font-size: 0.8rem; padding: 16px; text-align: left; font-weight: 600;">CONTACT</th>
                            <th style="color: #9ca3af; text-transform: uppercase; font-size: 0.8rem; padding: 16px; text-align: left; font-weight: 600;">JOINED</th>
                            <th style="color: #9ca3af; text-transform: uppercase; font-size: 0.8rem; padding: 16px; text-align: left; font-weight: 600;">ACCESS</th>
                            <th style="color: #9ca3af; text-transform: uppercase; font-size: 0.8rem; padding: 16px; text-align: left; font-weight: 600;">TOTAL SPENT</th>
                            <th style="color: #9ca3af; text-transform: uppercase; font-size: 0.8rem; padding: 16px; text-align: center; font-weight: 600;">ACTIONS</th>
                        </tr>
                    </thead>
                    <tbody id="users-list"></tbody>
                </table>
            </div>

            <!-- Pagination -->
            <div id="users-pagination" style="display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:12px; margin-top:16px;">
                <div id="users-page-info" style="color:#9ca3af; font-size:0.85rem;"></div>
                <div style="display:flex; align-items:center; gap:8px;">
                    <button onclick="adminApp.changeUserPage(-1)" class="btn-sm btn-edit" id="users-prev">← Prev</button>
                    <span id="users-page-label" style="color:#d1d5db; font-size:0.85rem; min-width:90px; text-align:center;"></span>
                    <button onclick="adminApp.changeUserPage(1)" class="btn-sm btn-edit" id="users-next">Next →</button>
                </div>
            </div>
        </div>

        <!-- GAMES VIEW -->
        <div id="view-games" class="view-section">
            <div class="flex justify-between items-center"
                style="margin-bottom: 25px; display: flex; justify-content: space-between;">
                <h2>Game Management</h2>
                <button class="btn btn-primary" onclick="adminApp.openContentModal('games')">+ Add Game</button>
            </div>
            <div style="background: #1f2937; border: 1px solid #374151; border-radius: 12px; margin-bottom: 20px;">
                <input type="text" onkeydown="if(event.key==='Enter') adminApp.filterTable('games-list', this.value)" placeholder="Search games... then press Enter" style="width: 100%; border: none; background: transparent; padding: 18px 20px; color: #9ca3af; outline: none; font-size: 0.95rem;">
            </div>
            <div class="data-table-container">
                <table>
                    <thead>
                        <tr>
                            <th>Title</th>
                            <th>Category</th>
                            <th>Type</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody id="games-list"></tbody>
                </table>
            </div>

        </div>

        <!-- LIVE TV VIEW -->
        <div id="view-livetv" class="view-section">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 25px;">
                <h2>Live TV Management</h2>
                <button class="btn btn-primary" onclick="adminApp.openLiveModal()">
                    <ion-icon name="add-circle"></ion-icon> Add Channel
                </button>
            </div>
            <div style="background: #1f2937; border: 1px solid #374151; border-radius: 12px; margin-bottom: 20px;">
                <input type="text" onkeydown="if(event.key==='Enter') adminApp.filterTable('live-list', this.value)" placeholder="Search channels... then press Enter" style="width: 100%; border: none; background: transparent; padding: 18px 20px; color: #9ca3af; outline: none; font-size: 0.95rem;">
            </div>
            <div class="data-table-container">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Channel</th>
                            <th>Categories</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody id="live-list"></tbody>
                </table>
            </div>
        </div>

        <!-- ADULT VIEW -->
        <div id="view-adult" class="view-section">
            <div class="flex justify-between items-center"
                style="margin-bottom: 25px; display: flex; justify-content: space-between;">
                <h2>Adult Content Management</h2>
                <button class="btn btn-primary" onclick="adminApp.openContentModal('adult')">+ Add Video</button>
            </div>
            <div style="background: #1f2937; border: 1px solid #374151; border-radius: 12px; margin-bottom: 20px;">
                <input type="text" onkeydown="if(event.key==='Enter') adminApp.filterTable('adult-list', this.value)" placeholder="Search videos... then press Enter" style="width: 100%; border: none; background: transparent; padding: 18px 20px; color: #9ca3af; outline: none; font-size: 0.95rem;">
            </div>
            <div class="data-table-container">
                <table>
                    <thead>
                        <tr>
                            <th>Title</th>
                            <th>Link</th>
                            <th>Type</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody id="adult-list"></tbody>
                </table>
            </div>
        </div>

        <!-- PAYMENTS VIEW -->
        <div id="view-payments" class="view-section">
            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:20px;flex-wrap:wrap;gap:12px;">
                <h2 style="margin:0;">Payment Management</h2>
                <button onclick="adminApp.loadPayments()" style="display:flex;align-items:center;gap:6px;background:#1f2937;border:1px solid #374151;color:#9ca3af;padding:8px 16px;border-radius:10px;font-size:0.82rem;cursor:pointer;"><ion-icon name="refresh-outline"></ion-icon> Refresh</button>
            </div>

            <!-- Top Revenue Summary Cards -->
            <div class="stats-grid" style="grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); margin-bottom:20px; gap: 15px;">
                <div class="stat-card" style="background: #1f2937; border: 1px solid #374151; padding: 15px;">
                    <div style="color: #9ca3af; font-size: 0.75rem; text-transform: uppercase; font-weight: 700; display: flex; justify-content: space-between; margin-bottom: 8px;">
                        TODAY <ion-icon name="calendar" style="color: #22c55e; font-size: 1.2rem;"></ion-icon>
                    </div>
                    <div id="rev-today" style="color: #fff; font-size: 1.3rem; font-weight: 700;">Tzs 0</div>
                </div>
                <div class="stat-card" style="background: #1f2937; border: 1px solid #374151; padding: 15px;">
                    <div style="color: #9ca3af; font-size: 0.75rem; text-transform: uppercase; font-weight: 700; display: flex; justify-content: space-between; margin-bottom: 8px;">
                        YESTERDAY <ion-icon name="time-outline" style="color: #14b8a6; font-size: 1.2rem;"></ion-icon>
                    </div>
                    <div id="rev-yesterday" style="color: #fff; font-size: 1.3rem; font-weight: 700;">Tzs 0</div>
                </div>
                <div class="stat-card" style="background: #1f2937; border: 1px solid #374151; padding: 15px;">
                    <div style="color: #9ca3af; font-size: 0.75rem; text-transform: uppercase; font-weight: 700; display: flex; justify-content: space-between; margin-bottom: 8px;">
                        LAST 7 DAYS <ion-icon name="calendar-outline" style="color: #f97316; font-size: 1.2rem;"></ion-icon>
                    </div>
                    <div id="rev-7days" style="color: #fff; font-size: 1.3rem; font-weight: 700;">Tzs 0</div>
                </div>
                <div class="stat-card" style="background: #1f2937; border: 1px solid #374151; padding: 15px;">
                    <div style="color: #9ca3af; font-size: 0.75rem; text-transform: uppercase; font-weight: 700; display: flex; justify-content: space-between; margin-bottom: 8px;">
                        THIS MONTH <ion-icon name="calendar-number" style="color: #3b82f6; font-size: 1.2rem;"></ion-icon>
                    </div>
                    <div id="rev-month" style="color: #fff; font-size: 1.3rem; font-weight: 700;">Tzs 0</div>
                </div>
                <div class="stat-card" style="background: #1f2937; border: 1px solid #374151; padding: 15px;">
                    <div style="color: #9ca3af; font-size: 0.75rem; text-transform: uppercase; font-weight: 700; display: flex; justify-content: space-between; margin-bottom: 8px;">
                        THIS YEAR <ion-icon name="calendar-clear" style="color: #a855f7; font-size: 1.2rem;"></ion-icon>
                    </div>
                    <div id="rev-year" style="color: #fff; font-size: 1.3rem; font-weight: 700;">Tzs 0</div>
                </div>
                <div class="stat-card" style="background: #1f2937; border: 1px solid #374151; padding: 15px;">
                    <div style="color: #9ca3af; font-size: 0.75rem; text-transform: uppercase; font-weight: 700; display: flex; justify-content: space-between; margin-bottom: 8px;">
                        ALL TIME <ion-icon name="server" style="color: #eab308; font-size: 1.2rem;"></ion-icon>
                    </div>
                    <div id="rev-alltime" style="color: #fff; font-size: 1.3rem; font-weight: 700;">Tzs 0</div>
                </div>
            </div>

            <!-- Gateway Breakdown -->
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 20px; margin-bottom: 30px;">
                <!-- Today Breakdown -->
                <div style="background: #1f2937; border: 1px solid #374151; border-radius: 12px; padding: 20px;">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px;">
                        <div style="display: flex; align-items: center; gap: 8px;">
                            <div style="width: 24px; height: 24px; background: rgba(34,197,94,0.1); border-radius: 6px; display: flex; align-items: center; justify-content: center;">
                                <div style="width: 12px; height: 12px; background: #22c55e; border-radius: 3px;"></div>
                            </div>
                            <span style="font-weight: 700; font-size: 0.9rem;">Today — Gateway Breakdown</span>
                        </div>
                        <span id="today-txns-count" style="color: #6b7280; font-size: 0.8rem;">0 txns</span>
                    </div>
                    <div id="today-total-breakdown" style="font-size: 1.5rem; font-weight: 700; color: #22c55e; margin-bottom: 20px;">Tzs 0</div>
                    
                    <div id="today-gateways-list" style="display: flex; flex-direction: column; gap: 15px;">
                        <!-- Breakdown items injected here -->
                    </div>
                </div>

                <!-- Yesterday Breakdown -->
                <div style="background: #1f2937; border: 1px solid #374151; border-radius: 12px; padding: 20px;">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px;">
                        <div style="display: flex; align-items: center; gap: 8px;">
                            <div style="width: 24px; height: 24px; background: rgba(251,191,36,0.1); border-radius: 6px; display: flex; align-items: center; justify-content: center;">
                                <ion-icon name="time" style="color: #fbbf24; font-size: 14px;"></ion-icon>
                            </div>
                            <span style="font-weight: 700; font-size: 0.9rem;">Yesterday — Gateway Breakdown</span>
                        </div>
                        <span id="yesterday-txns-count" style="color: #6b7280; font-size: 0.8rem;">0 txns</span>
                    </div>
                    <div id="yesterday-total-breakdown" style="font-size: 1.5rem; font-weight: 700; color: #fbbf24; margin-bottom: 20px;">Tzs 0</div>
                    
                    <div id="yesterday-gateways-list" style="display: flex; flex-direction: column; gap: 15px;">
                        <!-- Breakdown items injected here -->
                    </div>
                </div>
            </div>

            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px; flex-wrap: wrap; gap: 10px;">
                <h3 style="margin: 0; font-size: 1.1rem;">Transaction History</h3>
                <div style="display: flex; gap: 10px; align-items: center;">
                    <button onclick="adminApp.openExportModal()" style="background: #22c55e; color: #000; border: none; padding: 8px 16px; border-radius: 6px; font-weight: 600; font-size: 0.85rem; cursor: pointer; display: flex; align-items: center; gap: 6px;">
                        <ion-icon name="download-outline"></ion-icon> Export CSV
                    </button>
                    <input type="text" id="payments-search" placeholder="Search by phone, email, username..." onkeyup="adminApp.filterPaymentsTable()" style="background: #111827; border: 1px solid #374151; color: #fff; padding: 8px 12px; border-radius: 6px; font-size: 0.85rem; width: 250px;">
                    <select id="payments-status-filter" onchange="adminApp.filterPaymentsTable()" style="background: #111827; border: 1px solid #374151; color: #fff; padding: 8px 12px; border-radius: 6px; font-size: 0.85rem;">
                        <option value="all">All Statuses</option>
                        <option value="completed">Completed</option>
                        <option value="pending">Pending</option>
                        <option value="failed">Failed</option>
                    </select>
                </div>
                <div id="export-status-msg" style="width: 100%; font-size: 0.8rem; color: #6b7280; text-align: right;"></div>
            </div>

            <div class="data-table-container">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Order ID</th>
                            <th>User</th>
                            <th>Phone</th>
                            <th>Gateway</th>
                            <th>Content</th>
                            <th>Amount (Tsh)</th>
                            <th>Status</th>
                            <th>Date</th>
                        </tr>
                    </thead>
                    <tbody id="payments-tbody">
                        <tr><td colspan="8" style="text-align: center; color: #6b7280;">Loading payments...</td></tr>
                    </tbody>
                </table>
            </div>
        </div>

                <!-- SETTINGS VIEW -->
        <div id="view-settings" class="view-section">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
                <h2>System Settings</h2>
                <button class="btn btn-primary" onclick="adminApp.saveSettings()">Save Changes</button>
            </div>
            <div style="background: var(--surface); border: 1px solid var(--border); border-radius: 12px; padding: 20px; margin-bottom: 20px;">
                <h3 style="margin-bottom: 15px; border-bottom: 1px solid var(--border); padding-bottom: 10px;">Adult Section Subscription</h3>
                <div class="input-group">
                    <label>Subscription Duration (Days)</label>
                    <input type="number" id="setting-adult-duration" min="1" value="5">
                    <small style="color: #9ca3af; display: block; margin-top: 5px;">Number of days a user can access the 18+ section after payment.</small>
                </div>
                <div class="input-group">
                    <label>Subscription Price (Tsh)</label>
                    <input type="number" id="setting-adult-price" min="0" value="5000">
                    <small style="color: #9ca3af; display: block; margin-top: 5px;">Price in Tanzanian Shillings for the subscription.</small>
                </div>
                <div class="input-group">
                    <label>Maelezo ya Sehemu ya 18+ (Description)</label>
                    <textarea id="setting-adult-description" rows="4" style="width:100%; background:var(--surface); border:1px solid var(--border); border-radius:8px; padding:10px; color:#fff; font-size:0.9rem; resize:vertical;" placeholder="Andika maelezo yanayoonyeshwa kwa user kabla ya kununua..."></textarea>
                    <small style="color: #9ca3af; display: block; margin-top: 5px;">Maelezo haya yataonekana kwenye ukurasa wa 18+ Premium kabla ya mtumiaji kulipa.</small>
                </div>
            </div>

            <div style="background: var(--surface); border: 1px solid var(--border); border-radius: 12px; padding: 20px; margin-bottom: 20px;">
                <h3 style="margin-bottom: 15px; border-bottom: 1px solid var(--border); padding-bottom: 10px;">
                    <ion-icon name="tv-outline" style="vertical-align:middle; margin-right:6px; color:#6366f1;"></ion-icon>
                    Live TV Subscription Plan
                </h3>
                <p style="color:#9ca3af; font-size:0.85rem; margin-bottom:15px;">Weka bei na muda wa mpango wa Live TV. Mtumiaji akilipa, atafunguliwa channels zote za Live TV.</p>
                <div class="input-group">
                    <label>Enable Live TV Subscription Plan</label>
                    <label style="display:flex; align-items:center; gap:10px; cursor:pointer;">
                        <input type="checkbox" id="setting-live-enabled" style="width:20px; height:20px; accent-color:#6366f1;">
                        <span style="color:#d1d5db; font-size:0.9rem;">Activate (shows payment button on Live TV section)</span>
                    </label>
                </div>
                <div class="input-group">
                    <label>Subscription Duration (Days)</label>
                    <input type="number" id="setting-live-duration" min="1" value="30">
                    <small style="color: #9ca3af; display: block; margin-top: 5px;">Idadi ya siku mtumiaji anaweza kutazama Live TV baada ya kulipa.</small>
                </div>
                <div class="input-group">
                    <label>Subscription Price (Tsh)</label>
                    <input type="number" id="setting-live-price" min="0" value="5000">
                    <small style="color: #9ca3af; display: block; margin-top: 5px;">Bei katika Shilingi za Tanzania kwa mpango wa Live TV.</small>
                </div>
                <div class="input-group">
                    <label>Description (Maelezo ya Live TV Plan)</label>
                    <textarea id="setting-live-description" rows="3" style="width:100%; background:var(--surface); border:1px solid var(--border); border-radius:8px; padding:10px; color:#fff; font-size:0.9rem; resize:vertical;" placeholder="Furahia channels zote za Live TV kwa siku 30..."></textarea>
                    <small style="color: #9ca3af; display: block; margin-top: 5px;">Maelezo haya yataonekana kwa mtumiaji kabla ya kulipa.</small>
                </div>
            </div>
        </div>

    </div>

    <!-- MODALS -->
    <!-- Content Modal (Used for both Movies and Games) -->
    <div id="content-modal" class="modal">
        <div class="modal-content">
            <h2 id="modal-title" style="margin-bottom: 20px;">Add Content</h2>
            <input type="hidden" id="c-id">
            <!-- Hidden field to track if we represent Game or Movie context -->
            <input type="hidden" id="c-context">

            <div class="input-group">
                <label>Title</label>
                <input type="text" id="c-title">
            </div>
            <div class="input-group">
                <label>Category</label>
                <select id="c-category">
                    <!-- Options populated by JS based on context -->
                </select>
            </div>
            <div class="input-group">
                <label>Image URL</label>
                <div style="display: flex; gap: 10px;">
                    <input type="text" id="c-image" placeholder="https://..." style="flex: 1;">
                    <input type="file" id="c-image-upload" accept="image/*" style="display: none;"
                        onchange="adminApp.uploadImage(this)">
                    <button class="btn btn-secondary" onclick="document.getElementById('c-image-upload').click()"
                        style="background: #374151; color: white; border: 1px solid #4b5563;">Upload</button>
                </div>
                <small id="upload-status" style="display: block; margin-top: 5px; color: #9ca3af;"></small>
            </div>
            <div class="input-group">
                <label>Status</label>
                <select id="c-status"
                    style="width:100%; padding:10px; background:#374151; color:#fff; border:1px solid #4b5563; border-radius:8px;">
                    <option value="public">Public</option>
                    <option value="draft">Draft</option>
                </select>
            </div>

            <div class="input-group">
                <label>Price (Tsh) (Leave empty for Free)</label>
                <input type="number" id="c-price" placeholder="e.g. 2000">
            </div>

            <div id="group-game-meta">
                <div style="display:flex; gap:10px;">
                    <div class="input-group" style="flex:1;">
                        <label>Size (e.g. 1.2 GB)</label>
                        <input type="text" id="c-size" placeholder="Size">
                    </div>
                    <div class="input-group" style="flex:1;">
                        <label>Version (e.g. v1.0)</label>
                        <input type="text" id="c-version" placeholder="Version">
                    </div>
                </div>

                <div class="input-group">
                    <label>WhatsApp Number</label>
                    <input type="text" id="c-whatsapp" placeholder="+255...">
                </div>
            </div>

            <div class="input-group">
                <label>Duration in Days (e.g. 5 Days, 30 Days)</label>
                <input type="text" id="c-duration" placeholder="e.g. 5 Days">
            </div>

            <div class="input-group">
                <label>Description</label>
                <textarea id="c-description" rows="3" placeholder="Game/Movie Overview"
                    style="width:100%; padding:10px; background:#374151; color:#fff; border:1px solid #4b5563; border-radius:8px;"></textarea>
            </div>
            <div id="group-gameplay">
                <div class="input-group">
                    <label>Gameplay (Lilivyo Ndani) - YouTube/Link</label>
                    <input type="text" id="c-gameplay-video" placeholder="https://www.youtube.com/watch?v=...">
                </div>
            </div>
            <div id="group-howtoset">
                <div class="input-group">
                    <label>How to Set - Description</label>
                    <textarea id="c-howtoset-text" rows="3" placeholder="Step-by-step instructions..."
                        style="width:100%; padding:10px; background:#374151; color:#fff; border:1px solid #4b5563; border-radius:8px;"></textarea>
                </div>
                <div style="background: #1f2937; padding: 15px; border-radius: 12px; border: 1px solid #374151; margin-bottom: 15px;">
                    <div style="margin-bottom: 15px; border-bottom: 1px solid #374151; padding-bottom: 10px;">
                        <h4 style="margin: 0; color: #9ca3af; font-size: 0.85rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; display: flex; align-items: center; gap: 6px;">
                            <ion-icon name="play-circle-outline" style="font-size: 1.1rem;"></ion-icon> Tutorial Media Setup
                        </h4>
                    </div>
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 15px;">
                        <div class="input-group" style="margin-bottom: 0;">
                            <label style="color: #e5e7eb; display: flex; align-items: center; gap: 6px; font-size: 0.9rem;">
                                <ion-icon name="logo-youtube" style="color: #ef4444;"></ion-icon>
                                Video URL (YouTube/Drive)
                            </label>
                            <input type="text" id="c-howtoset-video" placeholder="https://www.youtube.com/watch?v=..." style="background: #111827; border: 1px solid #374151;">
                        </div>
                        <div class="input-group" style="margin-bottom: 0;">
                            <label style="color: #e5e7eb; display: flex; align-items: center; gap: 6px; font-size: 0.9rem;">
                                <ion-icon name="image-outline" style="color: #3b82f6;"></ion-icon>
                                Thumbnail (16:9)
                            </label>
                            <div style="display: flex; gap: 8px; align-items: center; background: #111827; border: 1px solid #374151; border-radius: 8px; padding: 4px;">
                                <input type="text" id="c-howtoset-thumbnail" placeholder="https://example.com/thumb.jpg" style="flex: 1; border: none; background: transparent; padding: 6px 10px; color: #fff; outline: none; box-shadow: none;">
                                <input type="file" id="c-howtoset-thumbnail-upload" accept="image/*" style="display: none;" onchange="adminApp.uploadThumbnailImage(this)">
                                <button type="button" onclick="document.getElementById('c-howtoset-thumbnail-upload').click()" 
                                    style="background: #2563eb; color: white; border: none; padding: 6px 12px; border-radius: 6px; cursor: pointer; font-weight: 500; font-size: 0.85rem; display: flex; align-items: center; gap: 5px; transition: background 0.2s;"
                                    onmouseover="this.style.background='#1d4ed8'" onmouseout="this.style.background='#2563eb'">
                                    <ion-icon name="cloud-upload-outline"></ion-icon> Upload
                                </button>
                            </div>
                            <small id="howtoset-thumbnail-upload-status" style="display: block; margin-top: 6px; color: #9ca3af; font-size: 0.8rem;"></small>
                        </div>
                    </div>
                </div>

            </div>

            <div id="group-specific-links" style="display: none;">
                <div class="input-group">
                    <label id="label-stream">Stream URL</label>
                    <input type="text" id="c-stream-url" placeholder="Paste streaming link here...">
                </div>
                <div class="input-group">
                    <label id="label-download">Download URL</label>
                    <input type="text" id="c-download-url" placeholder="Paste download link here...">
                </div>
            </div>

            <div class="input-group" id="group-movie-link">
                <label>Download/Streaming Links</label>
                <div id="links-container" style="margin-bottom: 10px;">
                    <!-- Link rows will be added here -->
                </div>
                <button type="button" class="btn-add-link" onclick="window.adminApp.addLinkRow()">
                    <ion-icon name="add-circle-outline"></ion-icon> Add Link
                </button>
            </div>
            <div style="display: flex; gap: 10px; justify-content: flex-end;">
                <button class="btn btn-secondary"
                    style="background: transparent; border: 1px solid #374151; color: #d1d5db; padding: 10px 20px; border-radius: 8px; cursor: pointer;"
                    onclick="document.getElementById('content-modal').classList.remove('show')">Cancel</button>
                <button class="btn btn-primary" onclick="adminApp.saveContent()">Save Content</button>
            </div>
        </div>
    </div>

    <!-- Live Channel Modal -->
    <div id="live-modal" class="modal">
        <div class="modal-content" style="max-width: 600px;">
            <h2 id="live-modal-title" style="margin-bottom: 20px;">Add Live Channel</h2>
            <input type="hidden" id="l-id">

            <div class="input-group">
                <label>Channel Name *</label>
                <input type="text" id="l-name" placeholder="e.g., BBC News, ESPN Sports">
            </div>

            <div class="input-group">
                <label>Description</label>
                <textarea id="l-description" rows="2" placeholder="Channel description..."
                    style="width:100%; padding:10px; background:#374151; color:#fff; border:1px solid #4b5563; border-radius:8px;"></textarea>
            </div>

            <div class="input-group">
                <label>Stream URL *</label>
                <input type="text" id="l-url" placeholder="https://...">
                <div class="stream-examples">
                    Supports: <b>HLS (.m3u8)</b>, <b>DASH (.mpd)</b>, MP4, TS streams, PHP script URLs, YouTube.<br>
                    • http://domain.com/play/live.php?mac=...&stream=...&extension=ts<br>
                    • https://example.com/stream.m3u8
                </div>
            </div>

            <div class="input-group">
                <select id="l-encryption"
                    style="width:100%; padding:10px; background:#374151; color:#fff; border:1px solid #4b5563; border-radius:8px;">
                    <option value="none">None (No Encryption)</option>
                    <option value="clearkey">ClearKey DRM</option>
                    <option value="widevine">Widevine DRM</option>
                </select>
            </div>

            <div class="input-group">
                <label>Price (Leave empty for Free)</label>
                <input type="number" id="l-price" placeholder="e.g., 2000">
            </div>

            <div class="input-group">
                <label>Thumbnail (Upload or URL - site logo used if empty)</label>
                <div style="display: flex; gap: 10px; margin-bottom: 10px;">
                    <input type="text" id="l-thumbnail" placeholder="https://..." style="flex: 1;">
                    <input type="file" id="l-image-file" style="display:none;"
                        onchange="adminApp.uploadLiveImage(this)">
                    <button class="btn btn-secondary" onclick="document.getElementById('l-image-file').click()"
                        style="background: #374151; border: 1px solid #4b5563; color: #fff; padding: 10px; border-radius: 8px; cursor: pointer; display: flex; align-items: center; gap: 5px;">
                        <ion-icon name="cloud-upload-outline"></ion-icon> Upload
                    </button>
                </div>
                <div id="l-upload-status" style="font-size: 0.8rem; margin-top: 5px;"></div>
            </div>

            <div class="input-group">
                <label>Categories * (Select at least one)</label>
                <div class="category-grid" id="l-categories">
                    <div class="cat-chip" onclick="this.classList.toggle('active')">Sport</div>
                    <div class="cat-chip" onclick="this.classList.toggle('active')">News</div>
                    <div class="cat-chip" onclick="this.classList.toggle('active')">Africa</div>
                    <div class="cat-chip" onclick="this.classList.toggle('active')">Tanzania</div>
                    <div class="cat-chip" onclick="this.classList.toggle('active')">Entertainment</div>
                    <div class="cat-chip" onclick="this.classList.toggle('active')">Music</div>
                    <div class="cat-chip" onclick="this.classList.toggle('active')">Kids</div>
                    <div class="cat-chip" onclick="this.classList.toggle('active')">Documentary</div>
                    <div class="cat-chip" onclick="this.classList.toggle('active')">Movies</div>
                    <div class="cat-chip" onclick="this.classList.toggle('active')">Series</div>
                    <div class="cat-chip" onclick="this.classList.toggle('active')">Other</div>
                </div>
            </div>

            <div style="display: flex; gap: 10px; justify-content: flex-end; margin-top: 25px;">
                <button class="btn btn-secondary"
                    style="background: transparent; border: 1px solid #374151; color: #d1d5db; padding: 10px 20px; border-radius: 8px; cursor: pointer;"
                    onclick="document.getElementById('live-modal').classList.remove('show')">Cancel</button>
                <button class="btn btn-primary" onclick="adminApp.saveLiveChannel()">Save Channel</button>
            </div>
        </div>
    </div>

    <!-- Export Modal -->
    <div id="export-modal" class="modal">
        <div class="modal-content" style="max-width: 550px;">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:15px; border-bottom:1px solid #374151; padding-bottom:15px;">
                <h2 style="margin:0; font-size:1.25rem; font-weight:700;">Export Payments</h2>
                <ion-icon name="close" style="font-size:1.5rem; cursor:pointer; color:#9ca3af;" onclick="document.getElementById('export-modal').classList.remove('show')"></ion-icon>
            </div>
            
            <p style="color:#9ca3af; font-size:0.9rem; margin-bottom:20px;">Select the date range for the payment export (Completed & Success only).</p>
            
            <div style="display:grid; grid-template-columns:1fr 1fr; gap:15px; margin-bottom:20px;">
                <label style="background:#273245; border:1px solid #374151; padding:12px 15px; border-radius:6px; cursor:pointer; display:flex; align-items:center; gap:10px;">
                    <input type="radio" name="export-range" value="today" checked onclick="document.getElementById('custom-range-inputs').style.display='none'">
                    <span>Today</span>
                </label>
                <label style="background:#273245; border:1px solid #374151; padding:12px 15px; border-radius:6px; cursor:pointer; display:flex; align-items:center; gap:10px;">
                    <input type="radio" name="export-range" value="last7" onclick="document.getElementById('custom-range-inputs').style.display='none'">
                    <span>Last 7 Days (Week)</span>
                </label>
                <label style="background:#273245; border:1px solid #374151; padding:12px 15px; border-radius:6px; cursor:pointer; display:flex; align-items:center; gap:10px;">
                    <input type="radio" name="export-range" value="alltime" onclick="document.getElementById('custom-range-inputs').style.display='none'">
                    <span>All Time</span>
                </label>
                <label style="background:#273245; border:1px solid #374151; padding:12px 15px; border-radius:6px; cursor:pointer; display:flex; align-items:center; gap:10px;">
                    <input type="radio" name="export-range" value="custom" onclick="document.getElementById('custom-range-inputs').style.display='flex'">
                    <span>Custom Range</span>
                </label>
            </div>

            <div id="custom-range-inputs" style="display:none; gap:15px; margin-bottom:20px;">
                <div style="flex:1;">
                    <label style="font-size:0.8rem; color:#9ca3af; margin-bottom:5px; display:block;">Start Date</label>
                    <input type="date" id="export-start" style="width:100%; padding:10px; background:#111827; border:1px solid #374151; color:#fff; border-radius:6px;">
                </div>
                <div style="flex:1;">
                    <label style="font-size:0.8rem; color:#9ca3af; margin-bottom:5px; display:block;">End Date</label>
                    <input type="date" id="export-end" style="width:100%; padding:10px; background:#111827; border:1px solid #374151; color:#fff; border-radius:6px;">
                </div>
            </div>

            <div style="border-top:1px solid #374151; padding-top:15px; display:flex; justify-content:flex-end;">
                <button class="btn btn-primary" onclick="adminApp.doExport()" style="background:#22c55e; color:#fff; border:none; padding:10px 20px; border-radius:6px; cursor:pointer; display:flex; align-items:center; gap:6px; font-weight:600; font-size:0.95rem;">
                    <ion-icon name="document-text" style="font-size:1.1rem;"></ion-icon> Download CSV
                </button>
            </div>
        </div>
    </div>

    <!-- Grant Access Modal -->
    <div id="grant-access-modal" class="modal">
        <div class="modal-content" style="max-width: 500px;">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:15px; border-bottom:1px solid #374151; padding-bottom:15px;">
                <h2 style="margin:0; font-size:1.25rem; font-weight:700;">Grant Premium Access</h2>
                <ion-icon name="close" style="font-size:1.5rem; cursor:pointer; color:#9ca3af;" onclick="document.getElementById('grant-access-modal').classList.remove('show')"></ion-icon>
            </div>
            
            <input type="hidden" id="grant-user-id">
            
            <div class="input-group">
                <label>Access Type</label>
                <select id="grant-type" onchange="window.adminApp.onGrantTypeChange()" style="width:100%; padding:10px; background:#111827; border:1px solid #374151; color:#fff; border-radius:6px;">
                    <option value="adult-section-access">All Adult Content (18+ Premium)</option>
                    <option value="adult">Specific Adult Content</option>
                    <option value="livetv-all">All Live TV Channels</option>
                    <option value="livetv">Specific Live TV Channel</option>
                    <option value="games">Games</option>
                </select>
            </div>

            <div id="grant-item-selection" style="display:none;">
                <div class="input-group">
                    <label id="grant-item-label">Select Item</label>
                    <input type="text" id="grant-item-search" placeholder="Search..." oninput="window.adminApp.filterGrantItems()" style="width:100%; padding:10px; background:#111827; border:1px solid #374151; color:#fff; border-radius:6px; margin-bottom:10px;">
                    <select id="grant-item-select" size="5" style="width:100%; padding:10px; background:#111827; border:1px solid #374151; color:#fff; border-radius:6px; height:120px; overflow-y:auto;">
                        <!-- Options populated via JS -->
                    </select>
                </div>
            </div>

            <div style="display: flex; gap: 10px; justify-content: flex-end; margin-top:20px;">
                <button class="btn btn-secondary" onclick="document.getElementById('grant-access-modal').classList.remove('show')" style="background: transparent; border: 1px solid #374151; color: #d1d5db; padding: 10px 20px; border-radius: 8px; cursor: pointer;">Cancel</button>
                <button class="btn btn-primary" onclick="window.adminApp.confirmGrantAccess()" style="background:#10b981; border:none; padding:10px 20px; border-radius:8px; color:white; font-weight:600; cursor:pointer;">Grant Access</button>
            </div>
        </div>
    </div>

    <script type="module">
        import api from '/scripts/api.js';
        import { auth, onAuthStateChanged } from '/scripts/firebase-config.js';

        const adminApp = {
            token: null,

            filterTable: function(tableId, query) {
                const lowerQuery = query.toLowerCase();
                document.querySelectorAll(`#${tableId} tr`).forEach(row => {
                    const text = row.innerText.toLowerCase();
                    row.style.display = text.includes(lowerQuery) ? '' : 'none';
                });
            },

            login: async function () {
                const email = document.getElementById('admin-user').value;
                const pass = document.getElementById('admin-pass').value;
                const res = await api.adminLogin({ email: email, password: pass });

                if (res.success) {
                    this.token = res.token;
                    sessionStorage.setItem('rajab_admin_token', res.token);
                    document.getElementById('login-overlay').style.display = 'none';
                    this.navigate('dashboard');
                } else {
                    document.getElementById('login-error').innerText = res.message;
                }
            },

            navigate: function (viewId) {
                // Sidebar Active State
                document.querySelectorAll('.menu-item').forEach(el => el.classList.remove('active'));

                // Map viewId to sidebar menu index (Manage Admins removed — admins
                // are managed only in Firebase). Order: Dashboard, Users, Games,
                // LiveTV, Adult, Payments, Settings, Withdrawals.
                const menuMap = {
                    'dashboard': 0, 'users': 1, 'games': 2, 'livetv': 3, 'adult': 4, 'payments': 5, 'settings': 6, 'withdrawals': 7
                };

                const menuItems = document.querySelectorAll('.menu-item');
                if (menuItems[menuMap[viewId]]) {
                    menuItems[menuMap[viewId]].classList.add('active');
                }

                // View Switching
                document.querySelectorAll('.view-section').forEach(el => el.classList.remove('active'));
                const targetView = document.getElementById('view-' + viewId);
                if (targetView) targetView.classList.add('active');

                // Load Data
                if (viewId === 'dashboard') this.loadDashboard();
                if (viewId === 'users') this.loadUsers();

                if (viewId === 'movies') this.loadContent('movies');
                if (viewId === 'games') this.loadContent('games');
                if (viewId === 'adult') this.loadContent('adult');
                if (viewId === 'livetv') this.loadContent('live');
                if (viewId === 'payments') this.loadPayments();
                if (viewId === 'settings') this.loadSettings();
                if (viewId === 'withdrawals') {
                    this.loadWithdrawals();
                    this._startWithdrawalsAutoRefresh();
                } else {
                    this._stopWithdrawalsAutoRefresh();
                }
                if (viewId === 'notifications') {
                    this.loadNotifHistory();
                    // Setup live preview listeners
                    setTimeout(() => {
                        const titleEl = document.getElementById('notif-title');
                        const bodyEl = document.getElementById('notif-body');
                        if (titleEl) titleEl.addEventListener('input', () => {
                            document.getElementById('preview-title').textContent = titleEl.value || 'Kichwa kitaonekana hapa';
                        });
                        if (bodyEl) bodyEl.addEventListener('input', () => {
                            document.getElementById('preview-body').textContent = bodyEl.value || 'Ujumbe wako utaonekana hapa...';
                        });
                    }, 100);
                }
            },

            // ─── REFRESH DASHBOARD ────────────────────────────────────────
            refreshDashboard: async function () {
                const btn  = document.getElementById('btn-refresh-dashboard');
                const icon = document.getElementById('refresh-icon');

                // Spin the icon + disable button while loading
                if (icon)  icon.style.transform  = 'rotate(360deg)';
                if (btn)   btn.disabled = true;

                await this.loadDashboard();

                // Reset after 800ms so animation completes
                setTimeout(() => {
                    if (icon) icon.style.transform = 'rotate(0deg)';
                    if (btn)  btn.disabled = false;
                }, 800);
            },

            loadDashboard: async function () {
                // Fetch payments ONCE and reuse across every dashboard widget
                // (previously this collection was fetched 4x per load).
                const payments = await api.getPayments();
                const completed = (payments || []).filter(p => ['completed','success','complete'].includes((p.status||'').toLowerCase()));

                const stats = await api.getDashboardStats(payments);
                document.getElementById('stat-games').innerText = stats.totalGames;
                document.getElementById('stat-users').innerText = stats.totalUsers;
                document.getElementById('stat-admins').innerText = stats.totalAdmins;

                // Live user activity — Active (online now) & Dead (inactive) users
                try {
                    const activity = await api.getUserActivity();
                    const activeEl = document.getElementById('stat-active-users');
                    const deadEl = document.getElementById('stat-dead-users');
                    const activeSub = document.getElementById('stat-active-sub');
                    if (activeEl) activeEl.innerText = activity.active;
                    if (deadEl) deadEl.innerText = activity.dead;
                    if (activeSub) activeSub.innerText = `${activity.active} kati ya ${activity.total} watumiaji`;
                } catch (e) { console.warn('User activity load failed:', e); }

                // Reuse the single payments fetch for the chart and breakdown.
                this.loadRevenueChart('7days', payments);
                this.loadGatewayBreakdown(completed);

                const txnEl = document.getElementById('stat-total-txns');
                if (txnEl) txnEl.textContent = `${completed.length} malipo yaliyokamilika`;
            },

            // --- CONTENT (Combined Logic) ---
            // --- CONTENT (Combined Logic) ---
            loadContent: async function (type) {
                const data = await api.getContent();
                window.allContent = data;

                let filtered = [];

                if (type === 'live') {
                    const tbody = document.getElementById('live-list');
                    filtered = data.filter(i => i.contentType === 'live');
                    tbody.innerHTML = filtered.map(i => `
                        <tr>
                            <td>
                                <div style="display:flex; align-items:center; gap: 10px;">
                                    <div style="width:40px; height:40px; border-radius:4px; background:#374151; display:flex; align-items:center; justify-content:center; overflow:hidden;">
                                        <img src="${i.image || 'https://placehold.co/40x40/111/fff?text=Live'}" style="width:100%; height:100%; object-fit:cover;" onerror="this.src='https://placehold.co/40x40/111/fff?text=Live'">
                                    </div>
                                    ${i.title}
                                </div>
                            </td>
                            <td>${(i.downloadLinks && Array.isArray(i.downloadLinks)) ? i.downloadLinks.join(', ') : 'None'}</td>
                            <td><span class="status-badge status-public">${i.status || 'public'}</span></td>
                            <td>
                                <div style="display:flex; gap:5px;">
                                    <button class="btn-sm btn-edit" onclick="adminApp.openLiveModal('${i.id}')"><ion-icon name="create"></ion-icon></button>
                                    <button class="btn-sm btn-del" onclick="deleteContent('${i.id}', 'live')"><ion-icon name="trash"></ion-icon></button>
                                </div>
                            </td>
                        </tr>
                    `).join('');
                    return;
                }

                // Filtering Logic: Prioritize 'contentType' (new field), fallback to 'category' (legacy)
                const isLive = (i) => i.contentType === 'live';
                const isGame = (i) => i.contentType === 'games' || (!i.contentType && ['tanzania-games', 'free-games', 'maleo-bus-mod', 'maleo-bus-skin', 'maleo-map-mod', 'program-and-app'].includes(i.category));
                const isAdult = (i) => i.contentType === 'adult' || i.isAdult;

                if (type === 'movies') {
                    // Show if explicitly movie, OR if NOT game/adult/live
                    filtered = data.filter(i => i.contentType === 'movies' || (!isGame(i) && !isAdult(i) && !isLive(i)));
                } else if (type === 'games') {
                    filtered = data.filter(i => isGame(i) && !isLive(i));
                } else if (type === 'adult') {
                    filtered = data.filter(i => isAdult(i) && !isLive(i));
                }

                // Sort by createdAt desc (newest first)
                filtered.sort((a, b) => {
                    const dateA = new Date(a.createdAt || 0);
                    const dateB = new Date(b.createdAt || 0);
                    return dateB - dateA;
                });

                const tbody = document.getElementById(type + '-list');
                tbody.innerHTML = filtered.map(item => `
                    <tr>
                        <td style="font-weight: 500; display: flex; align-items: center; gap: 10px;">
                            <img src="${item.image || 'https://placehold.co/40'}" style="width: 30px; height: 45px; object-fit: cover; border-radius: 4px;">
                            <div>
                                <div>${item.title} ${item.isTrending ? '🔥' : ''}</div>
                                <div style="font-size: 0.75rem; color: var(--text-muted);">${item.category}</div>
                            </div>
                        </td>
                         <td style="max-width: 150px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                            <a href="${item.movieLink || '#'}" target="_blank" style="color: var(--accent-color);">${item.movieLink ? 'Link' : '-'}</a>
                        </td>
                        <td>
                            <span style="padding: 4px 8px; border-radius: 4px; background: ${item.isFree ? 'rgba(0,255,0,0.2)' : 'rgba(255,0,0,0.2)'}; color: ${item.isFree ? '#00ff00' : '#ff4444'}; font-size: 0.75rem;">
                                ${item.isFree ? 'Free' : 'Paid'}
                            </span>
                            ${item.isAdult ? '<span style="padding: 4px 8px; border-radius: 4px; background: #991b1b; font-size: 0.75rem; margin-left: 5px;">18+</span>' : ''}
                        </td>
                        <td>
                            <div style="display:flex; gap: 8px;">
                                <button class="btn-sm btn-edit" onclick="window.editContent('${item.id}', '${type}')"><ion-icon name="create"></ion-icon></button>
                                <button class="btn-sm btn-del" onclick="window.deleteContent('${item.id}', '${type}')"><ion-icon name="trash"></ion-icon></button>
                            </div>
                        </td>
                    </tr>
                `).join('');
                window.allContent = data;
                window.currentContentType = type; // Track what view we are in
            },

            openContentModal: function (context, id = null) {
                document.getElementById('c-id').value = id || '';
                document.getElementById('c-context').value = context;

                let title = 'Add Content';
                if (context === 'movies') title = id ? 'Edit Movie' : 'Add Movie';
                if (context === 'games') title = id ? 'Edit Game' : 'Add Game';
                if (context === 'adult') title = id ? 'Edit Video' : 'Add Adult Video';
                document.getElementById('modal-title').innerText = title;
                document.getElementById('upload-status').innerText = '';

                // Populate Category Options based on context
                const catSelect = document.getElementById('c-category');
                const linkLabel = document.querySelector('#group-movie-link label');

                const gameplayLabel = document.querySelector('label[for="c-gameplay-video"]') || document.querySelector('#c-gameplay-video').previousElementSibling;

                const howtoSet = document.getElementById('group-howtoset');
                const gameMeta = document.getElementById('group-game-meta');
                const gameplayGroup = document.getElementById('group-gameplay');
                const specificLinks = document.getElementById('group-specific-links');
                const multiLinks = document.getElementById('group-movie-link');

                if (context === 'movies') {
                    howtoSet.style.display = 'none';
                    gameMeta.style.display = 'none';
                    gameplayGroup.style.display = 'none';
                    specificLinks.style.display = 'block';
                    multiLinks.style.display = 'none';
                    catSelect.innerHTML = `
                        <option value="Action">Action</option>
                        <option value="Comedy">Comedy</option>
                        <option value="Romance">Romance</option>
                        <option value="Horror">Horror</option>
                        <option value="Sci-Fi">Sci-Fi</option>
                        <option value="Drama">Drama</option>
                        <option value="Thriller">Thriller</option>
                        <option value="Animation">Animation</option>
                        <option value="Adventure">Adventure</option>
                        <option value="Crime">Crime</option>
                        <option value="Fantasy">Fantasy</option>
                    `;
                    linkLabel.innerText = 'Movie Link (Google Drive)';
                } else if (context === 'games') {
                    howtoSet.style.display = 'block';
                    gameMeta.style.display = 'block';
                    gameplayGroup.style.display = 'block';
                    specificLinks.style.display = 'none';
                    multiLinks.style.display = 'block';
                    catSelect.innerHTML = `
                        <option value="tanzania-games">Tanzania Games</option>
                        <option value="free-games">Games</option>
                        <option value="maleo-bus-mod">Maleo Bus Mod</option>
                        <option value="maleo-bus-skin">Maleo Bus Skin</option>
                        <option value="maleo-map-mod">Maleo Map Mod</option>
                        <option value="program-and-app">Program and App</option>
                    `;
                    linkLabel.innerText = 'Game Download Link';
                    gameplayLabel.innerText = 'Gameplay (Lilivyo Ndani) - YouTube/Link';
                } else if (context === 'adult') {
                    howtoSet.style.display = 'none';
                    gameMeta.style.display = 'none';
                    gameplayGroup.style.display = 'none';
                    specificLinks.style.display = 'block';
                    multiLinks.style.display = 'none';
                    catSelect.innerHTML = `
                        <option value="Connection">Connection</option>
                        <option value="X-Video">X-Video</option>
                    `;
                    linkLabel.innerText = 'Movie Link (Google Drive)';
                }

                if (id) {
                    const item = window.allContent.find(i => i.id === id);
                    if (item) {
                        document.getElementById('c-title').value = item.title;
                        document.getElementById('c-category').value = item.category;
                        document.getElementById('c-status').value = item.status || 'public';
                        document.getElementById('c-size').value = item.size || '';
                        document.getElementById('c-version').value = item.version || '';
                        document.getElementById('c-price').value = item.price || '';
                        document.getElementById('c-whatsapp').value = item.whatsapp || '';
                        document.getElementById('c-duration').value = item.duration || '5 Days';
                        document.getElementById('c-description').value = item.description || '';
                        document.getElementById('c-gameplay-video').value = item.gameplayVideoUrl || '';
                        document.getElementById('c-howtoset-text').value = item.howToSetText || item.howToSet || '';
                        document.getElementById('c-howtoset-video').value = item.howToSetVideo || '';
                        document.getElementById('c-howtoset-thumbnail').value = item.howToSetThumbnail || '';

                        document.getElementById('c-stream-url').value = item.streamUrl || '';
                        document.getElementById('c-download-url').value = item.downloadUrl || '';

                        // Handle Links
                        this.renderLinkRows(item.downloadLinks || (item.movieLink ? [item.movieLink] : []));

                        document.getElementById('c-image').value = item.image;
                    }
                } else {
                    document.getElementById('c-title').value = '';
                    document.getElementById('c-image').value = '';
                    document.getElementById('c-status').value = 'public';
                    document.getElementById('c-size').value = '';
                    document.getElementById('c-version').value = '';
                    document.getElementById('c-price').value = '';
                    document.getElementById('c-whatsapp').value = '';
                    document.getElementById('c-duration').value = '5 Days';
                    document.getElementById('c-description').value = '';
                    document.getElementById('c-gameplay-video').value = '';
                    document.getElementById('c-howtoset-text').value = '';
                    document.getElementById('c-howtoset-video').value = '';
                    document.getElementById('c-howtoset-thumbnail').value = '';

                    document.getElementById('c-stream-url').value = '';
                    document.getElementById('c-download-url').value = '';

                    this.renderLinkRows([]); // Empty links
                }
                document.getElementById('content-modal').classList.add('show');
            },

            addLinkRow: function (name = '', url = '') {
                const container = document.getElementById('links-container');
                const row = document.createElement('div');
                row.className = 'link-row';
                row.innerHTML = `
                    <input type="text" class="link-name" placeholder="Name (e.g. Server 1)" value="${name}">
                    <input type="text" class="link-url" placeholder="URL" value="${url}">
                    <button type="button" class="btn-remove" onclick="this.parentElement.remove()">
                        <ion-icon name="close"></ion-icon>
                    </button>
                `;
                container.appendChild(row);
            },

            renderLinkRows: function (links) {
                const container = document.getElementById('links-container');
                container.innerHTML = '';
                if (!links || links.length === 0) {
                    this.addLinkRow(); // Add one empty row by default
                    return;
                }
                links.forEach(link => {
                    if (typeof link === 'string') {
                        this.addLinkRow('', link);
                    } else {
                        this.addLinkRow(link.name, link.url);
                    }
                });
            },

            uploadImage: async function (input) {
                if (input.files && input.files[0]) {
                    const status = document.getElementById('upload-status');
                    status.innerText = 'Uploading... Please wait.';
                    status.style.color = '#fff';

                    // Alert to confirm function is running
                    // alert('Starting Image Upload...'); 

                    const formData = new FormData();
                    formData.append('image', input.files[0]);

                    try {
                        const res = await fetch('https://api.imgbb.com/1/upload?key=e4a54b1c8d8e2411273e5036b9f9bf12', {
                            method: 'POST',
                            body: formData
                        });
                        const data = await res.json();
                        if (data.success) {
                            document.getElementById('c-image').value = data.data.url;
                            status.innerText = 'Upload Complete!';
                            status.style.color = '#00ff00';
                            alert('Image Uploaded Successfully!');
                        } else {
                            status.innerText = 'Upload Failed: ' + (data.error ? data.error.message : 'Unknown error');
                            status.style.color = 'crimson';
                            alert('Upload Failed: ' + (data.error.message || 'Unknown Error'));
                        }
                    } catch (err) {
                        console.error(err);
                        status.innerText = 'Network Error during upload';
                        status.style.color = 'crimson';
                        alert('Network Error: Check internet connection');
                    }
                }
            },

