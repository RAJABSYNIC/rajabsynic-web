{
  "version": 2,
  "routes": [
    { "src": "/api/(.*)", "dest": "/server.js" },
    { "src": "/admin/?", "dest": "/admin.html" },
    { "src": "/sw.js", "dest": "/sw.js" },
    { "src": "/manifest.json", "dest": "/manifest.json" },
    { "src": "/styles/(.*)", "dest": "/styles/$1" },
    { "src": "/scripts/(.*)", "dest": "/scripts/$1" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
